<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/tools"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layoutRootActiveIncidence"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/incidence100"
    android:clickable="true"
    android:theme="@style/CustomAppTheme">

    <es.incidence.core.utils.view.INavigation
        android:id="@+id/inavigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <ScrollView
        android:id="@+id/incidenceDetailScrollView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/inavigation">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/margin_normal"
                android:layout_marginRight="@dimen/margin_normal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtAddress1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/inavigation"
                    android:layout_marginRight="@dimen/margin_normal"
                    android:lineHeight="22dp"
                    android:text="Home Title"
                    android:textColor="@color/black500"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/txtAddress2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/txtAddress1"
                    android:layout_marginTop="4dp"
                    android:layout_marginRight="@dimen/margin_normal"
                    android:lineHeight="30dp"
                    android:text="Big Title"
                    android:textColor="@color/black600"
                    android:textSize="20sp" />

                <androidx.cardview.widget.CardView
                    android:id="@+id/card_view"
                    android:layout_width="match_parent"
                    android:layout_height="220dp"
                    android:layout_below="@+id/txtAddress2"
                    android:layout_gravity="center"
                    android:layout_marginTop="16dp"
                    card_view:cardCornerRadius="8dp">

                    <com.mapbox.mapboxsdk.maps.MapView
                        android:id="@+id/mapView"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:clickable="true"
                        android:background="@android:color/transparent"
                        android:id="@+id/layoutMapClicable"/>

                </androidx.cardview.widget.CardView>

                <TextView
                    android:id="@+id/txtMessage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/card_view"
                    android:layout_marginTop="16dp"
                    android:gravity="center"
                    android:lineHeight="30dp"
                    android:text=""
                    android:textColor="@color/black600"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/txtEstimatedArrival"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/txtMessage"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:lineHeight="22dp"
                    android:text=""
                    android:textColor="@color/black500"
                    android:textSize="12sp" />
            </LinearLayout>

            <ListView
                android:id="@+id/lvOptions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:divider="@android:color/transparent"
                android:dividerHeight="0dp"
                android:layout_marginTop="16dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/margin_normal"
                android:layout_marginRight="@dimen/margin_normal"
                android:orientation="vertical">

                <RelativeLayout
                    android:id="@+id/layoutFace"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/red_border"
                    android:paddingBottom="8dp"
                    android:visibility="visible">

                    <ImageView
                        android:id="@+id/imgFace"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_marginLeft="16dp"
                        android:layout_marginTop="16dp"
                        android:layout_marginRight="16dp"
                        android:layout_marginBottom="16dp"
                        android:src="@drawable/ic_warning"
                        app:tint="@color/error" />

                    <TextView
                        android:id="@+id/txtMistake"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:layout_marginRight="16dp"
                        android:layout_marginBottom="24dp"
                        android:layout_toRightOf="@+id/imgFace"
                        android:lineHeight="18dp"
                        android:text="@string/incidence_key_mistake_desc"
                        android:textColor="@color/black600"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/txtPress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_alignParentBottom="true"
                        android:layout_marginTop="16dp"
                        android:layout_marginRight="16dp"
                        android:layout_marginBottom="16dp"
                        android:layout_toRightOf="@+id/imgFace"
                        android:lineHeight="24dp"
                        android:text="@string/incidence_key_press_here"
                        android:textColor="@color/error"
                        android:textSize="12sp"
                        android:textAlignment="center"/>

                </RelativeLayout>

                <com.ncorti.slidetoact.SlideToActView
                    android:id="@+id/slider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="16dp"
                    android:elevation="0dp"
                    app:animation_duration="250"
                    app:area_margin="0dp"
                    app:border_radius="8dp"
                    app:bounce_on_start="true"
                    card_view:slider_height="55dp"
                    card_view:icon_margin="10dp"
                    card_view:area_margin="4dp"
                    app:slider_locked="true"
                    app:text=""
                    app:text_size="12sp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</RelativeLayout>